{
  "name": "vairas",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/dev-api.mjs",
    "build": "ng build --configuration production",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:e2e": "node --test --test-concurrency=1 e2e/live.spec.mjs",
    "lint": "eslint src",
    "format": "prettier --write src scripts e2e .github *.json *.md *.mjs *.cjs",
    "format:check": "prettier --check src scripts e2e .github *.json *.md *.mjs *.cjs",
    "test:coverage": "ng test --watch=false --configuration coverage",
    "setup:coverage": "npm install --no-save --package-lock=false --ignore-scripts @vitest/coverage-v8@4.1.10",
    "test:theme": "node --test e2e/theme.spec.mjs"
  },
  "private": true,
  "packageManager": "npm@11.21.3",
  "dependencies": {
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "@angular/router": "21.2.26",
    "@primeuix/themes": "2.0.2",
    "primeng": "21.0.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.31",
    "@angular/cli": "21.2.31",
    "@angular/compiler-cli": "21.2.26",
    "@eslint/js": "9.39.2",
    "@tailwindcss/postcss": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "angular-eslint": "21.4.0",
    "eslint": "9.39.2",
    "jsdom": "28.1.0",
    "playwright-core": "1.59.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.1.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  }
}
